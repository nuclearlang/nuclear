// Word frequencies: a deterministic text of 2 000 000 words (Park-Miller generator), counted and ranked.
next(seed: int) int
  (seed * 48271) % 2147483647

main() void
  words = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu", "xi", "omicron", "pi"]
  counts: <string, int> = {}
  seed = 42
  total = 0
  for i in 0..2000000
    seed = next(seed)
    w = words[seed % words.length]
    counts[w] = (counts[w] ?? 0) + 1
    total += 1
  ranked = counts.keys.sortedBy((w) => (999999 - counts[w]!) * 100 + words.indexOf(w))
  for w in ranked.take(5)
    print("${w} ${counts[w]}")
  print("total ${total} distinct ${counts.length}")
